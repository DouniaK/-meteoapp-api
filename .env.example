# Copier ce fichier en .env et adapter les valeurs. Ne JAMAIS commiter le .env.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meteoapp
# Mettre true si la base est hébergée et impose SSL (Neon, Render, ...)
DATABASE_SSL=false
# Longue chaîne aléatoire, ex. générée avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi
JWT_EXPIRES_IN=7d

# Base NoSQL (MongoDB Atlas) : historique de recherches. Facultatif.
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.xxxxx.mongodb.net/
MONGODB_DB=meteoapp
# Durée de conservation de l'historique en jours (0 = illimitée)
HISTORY_TTL_DAYS=90
